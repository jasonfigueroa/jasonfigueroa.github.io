{
  "name": "jason-figueroa-site",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && eleventy",
    "dev": "node scripts/clean.mjs && eleventy --serve --port=8080",
    "check": "node scripts/check-site.mjs",
    "test": "pnpm build && pnpm check",
    "audit:site": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "cheerio": "1.2.0",
    "lighthouse": "^13.5.0",
    "markdown-it": "14.1.0",
    "markdown-it-anchor": "9.2.0"
  }
}
